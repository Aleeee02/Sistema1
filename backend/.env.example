# Usa la conexión directa o el Session Pooler de Supabase.
# Escapa los caracteres especiales de la contraseña como URL.
DATABASE_URL=postgresql+asyncpg://postgres.PROJECT_REF:TU_PASSWORD@HOST_SUPABASE:5432/postgres
DATABASE_SSL=true
DATABASE_SSL_VERIFY=false

APP_NAME=Taller SaaS API
APP_ENV=development
API_V1_PREFIX=/api/v1

# Genera una cadena aleatoria larga. No uses este valor en producción.
JWT_SECRET=CAMBIA_ESTA_CLAVE_POR_UNA_ALEATORIA_DE_AL_MENOS_32_CARACTERES
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Orígenes separados por coma.
CORS_ORIGINS=http://localhost:3000

# Opcional para integrar Supabase Storage más adelante.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=COLOCA_LA_CLAVE_SOLO_EN_EL_BACKEND
SUPABASE_STORAGE_BUCKET=taller-archivos

# URL pública del frontend, utilizada en los enlaces enviados por correo.
FRONTEND_URL=http://localhost:3000

# Correo SMTP. En producción completa estos valores con tu proveedor.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Gestión de taller
SMTP_USE_TLS=true
SMTP_USE_SSL=false
